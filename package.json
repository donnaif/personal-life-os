{
  "name": "personal-life-os",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Life OS - tasks, time, habits and productivity platform (Web + Windows + Android)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "build:core": "npm run build --workspace @lifeos/core",
    "build:web": "npm run build --workspace @lifeos/web",
    "build:desktop": "npm run build --workspace @lifeos/desktop",
    "dev:api": "npm run dev --workspace @lifeos/api",
    "dev:web": "npm run dev --workspace @lifeos/web",
    "dev:desktop": "npm run dev --workspace @lifeos/desktop",
    "smoke:desktop": "npm run smoke --workspace @lifeos/desktop",
    "package:win": "npm run package:win --workspace @lifeos/desktop",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^5.0.5",
    "@types/node": "^22.10.2"
  }
}
