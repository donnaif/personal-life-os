{
  "name": "@lifeos/desktop",
  "version": "0.1.0",
  "private": true,
  "productName": "Personal Life OS",
  "description": "Personal Life OS desktop shell (Electron) hosting the existing web UI and proxying the local API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-icon.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "icons": "node scripts/make-icon.mjs",
    "package:win": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.10.2",
    "electron": "^44.9.0",
    "typescript": "^5.6.3"
  }
}
