# Personal Life OS — نموذج متغيّرات البيئة
# انسخه إلى .env واملأ القيم محليًا. لا تُرفع .env إلى Git أبدًا.

# ---- خادم الـAPI ----
NODE_ENV=development
PORT=3100
HOST=127.0.0.1
# مصادر CORS المسموحة (واجهة التطوير)
CORS_ORIGINS=http://localhost:3101

# ---- قاعدة البيانات (SQLite معزولة) ----
# المسار نسبي إلى جذر المستودع ما لم يكن مطلقًا.
DATABASE_URL=file:./data/lifeos.sqlite

# ---- المصادقة ----
# سلسلة عشوائية 32 حرفًا على الأقل. توليد:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_LOCAL_SECRET
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ---- تطبيق سطح المكتب (اختياري) ----
# وجهة الـAPI ومنفذ الخادم المحلي للتطبيق
# LIFEOS_API_URL=http://127.0.0.1:3100
# LIFEOS_DESKTOP_PORT=3105

# ---- تحقّق آلي فقط (لا تُستخدم في الإنتاج) ----
# بيانات الدخول التي يستعملها وضع الفحص في تطبيق سطح المكتب
# LIFEOS_E2E_EMAIL=
# LIFEOS_E2E_PASSWORD=
